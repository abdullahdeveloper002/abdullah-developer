# Public URL of the deployed site. Used for Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Where the contact form delivers messages. Any service that accepts a JSON POST works
# (for example a Formspree endpoint: https://formspree.io/f/xxxxxxxx).
# Leave empty and the form falls back to a prefilled mailto link.
CONTACT_FORM_ENDPOINT=
